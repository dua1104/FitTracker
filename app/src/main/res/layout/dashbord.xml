<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Header - Today -->

    <!-- Calories Summary Card -->
    <TextView
        android:id="@+id/todayHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/today"
        android:textColor="@color/bleu_fonce"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/summaryCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@+id/todayHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calorie_summary"
                android:textSize="18sp"
                android:textColor="@color/bleu_fonce"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Calories Consumed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="301dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/calories_consumed"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/caloriesConsumed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calories_format"
                    android:textColor="@color/green"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Calories Burned -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/calories_burned"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/caloriesBurned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calories_format"
                    android:textColor="@color/red"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Calorie Balance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/calorie_balance"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/netCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calories_format"
                    android:textColor="@color/bleu_fonce"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Water Goal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/objectif_eau"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/waterGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/water_goal_format"
                    android:textColor="@color/bleu"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Quick Actions Title -->
    <TextView
        android:id="@+id/quickActionsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/action_rapide"
        android:textSize="18sp"
        android:textColor="@color/bleu_fonce"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/summaryCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Actions Buttons -->
    <LinearLayout
        android:id="@+id/quickActionsLayout"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@+id/quickActionsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp">

        <!-- Add Meal Button -->
        <Button
            android:id="@+id/btnAddMeal"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:backgroundTint="@color/green"
            android:text="@string/add_meal"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Add Sport Button -->
        <Button
            android:id="@+id/btnAddSport"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:backgroundTint="@color/bleu"
            android:text="@string/add_sport"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Add Water Button -->
        <Button
            android:id="@+id/btnAddWater"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:backgroundTint="@color/pink"
            android:text="@string/add_water"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Recent Activities Title -->
    <TextView
        android:id="@+id/recentActivitiesTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/recent_activities"
        android:textSize="18sp"
        android:textColor="@color/bleu_fonce"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/quickActionsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <!-- Recent Activities Placeholder -->
    <TextView
        android:id="@+id/emptyActivities"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/no_recent_activities"
        android:textColor="@color/black"
        android:gravity="center"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@+id/recentActivitiesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
